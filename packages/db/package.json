    "test:integration": "node ./scripts/run-content-integration.mjs"
  },
  "dependencies": {
    "@magazine/config": "workspace:*",
    "@magazine/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
