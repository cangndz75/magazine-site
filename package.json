{
  "name": "magazine-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:editor": "pnpm --filter editor dev",
    "dev": "pnpm --parallel --filter web --filter editor dev",
    "build:web": "pnpm --filter web build",
    "build:editor": "pnpm --filter editor build",
    "build": "pnpm build:web && pnpm build:editor",
    "lint": "pnpm --filter web lint && pnpm --filter editor lint"
  }
}