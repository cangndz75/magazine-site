# Magazine Site Environment

# Copy this file to:
#   apps/web/.env.local
#   apps/editor/.env.local
#
# Next.js loads env files from each application directory, not the repo root.
# NODE_ENV is owned by Next.js. Do not set it here.
#
# APP_ENV accepts: development | test | staging | production

# Runtime
APP_ENV=development

# Application URLs
SITE_URL=http://localhost:3000
EDITOR_URL=http://localhost:3001
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media

# Public NewsArticle publisher identity (server-only). Do not use NEXT_PUBLIC_*.
# Name is required to emit publisher. URL and logo are omitted when empty
# or invalid and are never defaulted to SITE_URL.
SITE_PUBLISHER_NAME=
SITE_PUBLISHER_URL=
SITE_PUBLISHER_LOGO_URL=

# Internal machine endpoints
# SCHEDULED_PUBLISH_RUNNER_SECRET: editor outbox/scheduler processor auth.
# PUBLIC_CACHE_INVALIDATION_SECRET: editor delivers, web verifies. Never NEXT_PUBLIC_*.
# PUBLIC_WEB_INTERNAL_BASE_URL: editor-only server URL of the public web app.
SCHEDULED_PUBLISH_RUNNER_SECRET=replace-with-at-least-32-random-characters
PUBLIC_CACHE_INVALIDATION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_WEB_INTERNAL_BASE_URL=http://localhost:3000

# --------------------------------------------------
# Server-only database (packages/db)
#
# Not required for lint, typecheck, or production build.
# Never prefix with NEXT_PUBLIC_.
# Do not commit real credentials.
# Do not use drizzle-kit push.
# --------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/magazine_site

# --------------------------------------------------
# Opt-in editor content PostgreSQL integration tests
# (pnpm --filter @magazine/db test:integration)
#
# Required. This command does not fall back to DATABASE_URL.
# Use a loopback host and a database name ending in _test.
# Never point this at staging or production.
# --------------------------------------------------
# EDITOR_CONTENT_TEST_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/magazine_site_content_test

# --------------------------------------------------
# Additional server-only secrets will be documented
# below as integrations are added.
#
# STAFF_MFA_ENCRYPTION_KEY: 32-byte AES-256 key, base64url-encoded.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required in staging/production. Never commit a real key.
# STAFF_MFA_ENCRYPTION_KEY=
# STAFF_MFA_TOTP_ISSUER=Magazine Editor

# --------------------------------------------------
# Media object storage (editor, server-only)
#
# MEDIA_STORAGE_MODE=local | s3
# local is for development only. staging/production must use s3.
# MEDIA_PUBLIC_BASE_URL is the public CDN or local web origin prefix.
# Never prefix these with NEXT_PUBLIC_.
# --------------------------------------------------
# MEDIA_STORAGE_MODE=local
# MEDIA_LOCAL_ROOT=D:/magazine-site/apps/web/public/media
# MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media
#
# Production / R2 example:
# MEDIA_STORAGE_MODE=s3
# MEDIA_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# MEDIA_S3_BUCKET=magazine-media
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_REGION=auto
# MEDIA_PUBLIC_BASE_URL=https://media.example.com
